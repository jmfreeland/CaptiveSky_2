# This repo tracks non-binary project files only (source, config, docs).
# Content/ is all binary .uasset/.umap and is handled elsewhere.
/Content/

# Binary terrain-generation exports (heightmaps/textures) -- keep the JSON/txt provenance files
Assets/**/*.exr
Assets/**/*.png

# Unreal-generated / build directories
/Binaries/
/Build/
/DerivedDataCache/
/Intermediate/
/Saved/
# Runtime agent state is backed up externally; authored identity/personality docs remain tracked.
/AgentMemory/
/Agents/*/memory.jsonl
/Agents/*/relationships.json
/Agents/*/relationship_events.jsonl
/Agents/*/personality_evolution.json
/Agents/*/personality_history.jsonl
/Agents/*/journal/
/Agents/*/.gateway/

# Standalone agent gateway build/runtime output
/Gateway/**/bin/
/Gateway/**/obj/
/Gateway/logs/
/.dotnet-cli/
/.nuget-packages/

# IDE / generated project files
.vs/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
.vscode/
.idea/
.claude/

# OS junk
.DS_Store
Thumbs.db
